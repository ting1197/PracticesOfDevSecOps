<%- include('layout', { body: `
<div class="page-header">
  <h1 class="page-header__title">Discover Products</h1>
  <p class="page-header__subtitle">Browse our curated collection of premium items</p>
</div>

${typeof error !== 'undefined' && error ? `
<div class="service-error">
  <div class="service-error__icon">⚠️</div>
  <div class="service-error__title">Service Unavailable</div>
  <div class="service-error__text">${error}</div>
</div>
` : ''}

${products.length > 0 ? `
<div class="product-grid">
  ${products.map((product, index) => {
    const gradientIndex = (index % 6) + 1;
    const initials = product.name ? product.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase() : '??';
    const stockLevel = product.stock || product.quantity || 0;
    let stockBadge = '';
    if (stockLevel > 10) {
      stockBadge = '<span class="badge badge--success"><span class="badge__dot"></span> In Stock (' + stockLevel + ')</span>';
    } else if (stockLevel > 0) {
      stockBadge = '<span class="badge badge--warning"><span class="badge__dot"></span> Low Stock (' + stockLevel + ')</span>';
    } else {
      stockBadge = '<span class="badge badge--danger"><span class="badge__dot"></span> Out of Stock</span>';
    }
    const isOutOfStock = stockLevel <= 0;
    return `
    <div class="product-card">
      <div class="product-card__image product-card__image--gradient-${gradientIndex}">
        ${initials}
      </div>
      <div class="product-card__body">
        <div class="product-card__name">
          <a href="/product/${product.id}">${product.name}</a>
        </div>
        <div class="product-card__price">$${parseFloat(product.price).toFixed(2)}</div>
        <div class="product-card__stock">${stockBadge}</div>
        <div class="product-card__actions">
          ${isOutOfStock ? `
            <button class="btn btn--primary btn--block btn--disabled" disabled>Out of Stock</button>
          ` : `
            <form action="/cart/add" method="POST">
              <input type="hidden" name="productId" value="${product.id}">
              <input type="hidden" name="productName" value="${product.name}">
              <input type="hidden" name="price" value="${product.price}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="btn btn--primary btn--block">Add to Cart</button>
            </form>
          `}
        </div>
      </div>
    </div>`;
  }).join('')}
</div>
` : `
<div class="empty-state">
  <div class="empty-state__icon">📦</div>
  <div class="empty-state__title">No Products Available</div>
  <div class="empty-state__text">Check back later for new arrivals!</div>
</div>
`}
` }) %>
