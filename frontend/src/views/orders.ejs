<%- include('layout', { body: `
<div class="page-header">
  <h1 class="page-header__title">My Orders</h1>
  <p class="page-header__subtitle">Track your order history and status</p>
</div>

${typeof error !== 'undefined' && error ? `
<div class="service-error">
  <div class="service-error__icon">⚠️</div>
  <div class="service-error__title">Service Unavailable</div>
  <div class="service-error__text">${error}</div>
</div>
` : ''}

${orders.length > 0 ? `
<div class="order-list">
  ${orders.map(order => {
    const status = (order.status || 'pending').toLowerCase();
    let statusClass = 'badge--warning';
    let statusIcon = '⏳';
    if (status === 'confirmed' || status === 'completed') {
      statusClass = 'badge--success';
      statusIcon = '✅';
    } else if (status === 'failed' || status === 'cancelled') {
      statusClass = 'badge--danger';
      statusIcon = '❌';
    }
    const orderDate = order.createdAt || order.created_at || order.date;
    const formattedDate = orderDate ? new Date(orderDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A';
    const orderTotal = order.totalAmount || order.total_amount || order.total || '0.00';
    const items = order.items || order.orderItems || [];
    return `
    <div class="order-card">
      <div class="order-card__header">
        <div>
          <div class="order-card__id">Order #${order.id || order.orderId || 'N/A'}</div>
          <div class="order-card__date">${formattedDate}</div>
        </div>
        <div class="order-card__meta">
          <span class="badge ${statusClass}">
            ${statusIcon} ${status.charAt(0).toUpperCase() + status.slice(1)}
          </span>
          <span class="order-card__total">$${parseFloat(orderTotal).toFixed(2)}</span>
        </div>
      </div>
      ${items.length > 0 ? `
      <div class="order-card__body">
        <ul class="order-card__items">
          ${items.map(item => `
            <li class="order-card__item">
              <span class="order-card__item-name">${item.productName || item.product_name || 'Product #' + (item.productId || item.product_id || '?')}</span>
              <span class="order-card__item-qty">×${item.quantity}</span>
            </li>
          `).join('')}
        </ul>
      </div>
      ` : ''}
    </div>`;
  }).join('')}
</div>
` : `
<div class="empty-state">
  <div class="empty-state__icon">📋</div>
  <div class="empty-state__title">No Orders Yet</div>
  <div class="empty-state__text">Once you place an order, it will appear here.</div>
  <a href="/" class="btn btn--primary">Start Shopping</a>
</div>
`}
` }) %>
