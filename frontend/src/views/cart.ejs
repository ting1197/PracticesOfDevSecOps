<%- include('layout', { body: `
<div class="page-header">
  <h1 class="page-header__title">Shopping Cart</h1>
  <p class="page-header__subtitle">${cart.length > 0 ? cart.length + ' item' + (cart.length !== 1 ? 's' : '') + ' in your cart' : 'Your cart is empty'}</p>
</div>

${cart.length > 0 ? `
<div class="table-container">
  <table class="table" id="cart-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Quantity</th>
        <th>Unit Price</th>
        <th>Subtotal</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      ${cart.map(item => `
        <tr>
          <td class="table__product-name">${item.productName}</td>
          <td>${item.quantity}</td>
          <td class="table__price">$${item.price.toFixed(2)}</td>
          <td class="table__subtotal">$${(item.price * item.quantity).toFixed(2)}</td>
          <td>
            <form action="/cart/remove" method="POST" style="display:inline;">
              <input type="hidden" name="productId" value="${item.productId}">
              <button type="submit" class="btn btn--danger btn--sm">Remove</button>
            </form>
          </td>
        </tr>
      `).join('')}
    </tbody>
  </table>
</div>

<div class="cart-summary">
  <div class="cart-summary__total">
    Total: <strong>$${total.toFixed(2)}</strong>
  </div>
  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/" class="btn btn--ghost">Continue Shopping</a>
    <form action="/checkout" method="POST" style="display:inline;">
      <button type="submit" class="btn btn--success btn--lg" id="checkout-btn">🛒 Checkout</button>
    </form>
  </div>
</div>
` : `
<div class="empty-state">
  <div class="empty-state__icon">🛒</div>
  <div class="empty-state__title">Your Cart is Empty</div>
  <div class="empty-state__text">Looks like you haven't added any items to your cart yet.</div>
  <a href="/" class="btn btn--primary">Browse Products</a>
</div>
`}
` }) %>
