# ===================================
# E-commerce Microservices Environment
# ===================================
# Copy this file to .env and update values:
#   cp .env.example .env

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# PostgreSQL Container
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=ecommerce

# Service Ports
FRONTEND_PORT=3000
ORDER_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002

# Service URLs (K8s internal DNS)
ORDER_SERVICE_URL=http://order-service:3001
INVENTORY_SERVICE_URL=http://inventory-service:3002

# Node Environment (development | production)
NODE_ENV=development
LOG_LEVEL=debug

# Grafana Admin
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# TLS Domain
TLS_DOMAIN=shop.local
